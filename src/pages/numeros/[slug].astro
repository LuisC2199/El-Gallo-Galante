---
import Shell from "../../layouts/Shell.astro";
import PostPreview from "../../components/PostPreview.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import { formatIssueDate } from "../../lib/format-issue-date";

export async function getStaticPaths() {
  const issues: CollectionEntry<"issues">[] = await getCollection("issues");

  return issues.map((issue: CollectionEntry<"issues">) => ({
    params: { slug: issue.id.replace(/\.md$/, '') },
    props: { issue },
  }));
}

const { issue } = Astro.props as { issue: CollectionEntry<"issues"> };
const issueDescription = issue.data.description?.trim();
const issueBody = issue.body?.trim() ?? "";
const hasExpandableIssueText = Boolean(
  issueBody || (issueDescription && issueDescription.length > 220)
);
const { Content: IssueContent } = await issue.render();

// Load all posts and filter to this issue
const allPosts: CollectionEntry<"posts">[] = await getCollection("posts",
  (p: CollectionEntry<"posts">) => (p.data.status ?? "published") === "published",
);

// Use issue slug (without .md extension) to match posts
const issueSlug = issue.id.replace(/\.md$/, '');

const issuePosts = allPosts.filter((post) => post.data.issue === issueSlug);
// Load authors for each post
const issuePostsWithAuthors: { post: CollectionEntry<"posts">; author: CollectionEntry<"authors"> }[] =
  await Promise.all(
    issuePosts.map(async (post: CollectionEntry<"posts">) => {
      const author = await getEntry(post.data.author);
      if (!author) throw new Error(`Author not found for post: ${post.slug}`);
      return { post, author };
    })
  );


// Count only published posts in this issue, with alphabetical category tie-breaks.
const alphabetical = new Intl.Collator("es-MX", { sensitivity: "base" });
const postsByCategory = new Map<string, typeof issuePostsWithAuthors>();
for (const entry of issuePostsWithAuthors) {
  const category = entry.post.data.category;
  const entries = postsByCategory.get(category) ?? [];
  entries.push(entry);
  postsByCategory.set(category, entries);
}
const categoryGroups = Array.from(postsByCategory, ([category, posts]) => ({
  category,
  posts: posts.sort((a, b) =>
    alphabetical.compare(a.post.data.title, b.post.data.title) ||
    alphabetical.compare(a.post.slug, b.post.slug)
  ),
})).sort((a, b) =>
  a.posts.length - b.posts.length || alphabetical.compare(a.category, b.category)
);

---

<Shell title={`${issue.data.title} · El Gallo Galante`} description={issueDescription}>
  <div class="max-w-6xl mx-auto px-6">
    {/* Issue Header */}
    <header class="max-w-3xl mx-auto mb-16 md:mb-24 text-center">
      {/* Cover Image (optional, large) */}
      {issue.data.coverImage && (
        <div class="mb-10 max-w-xl mx-auto">
          <img
            src={issue.data.coverImage}
            alt={issue.data.title}
            class="w-full h-auto rounded-lg shadow-lg grayscale hover:grayscale-0 transition-all duration-700"
            loading="eager"
          />
        </div>
      )}

      <p class="text-[10px] tracking-[0.3em] uppercase font-bold text-stone-800 bg-stone-100 inline-block px-4 py-1">
        Edición {issue.data.number || ''}
      </p>

      <h1 class="display-serif text-4xl md:text-7xl font-bold leading-tight mt-6">
        {issue.data.title}
      </h1>

      <p class="mt-4 text-sm md:text-base text-stone-500 tracking-wide serif">
        {formatIssueDate(issue.data.date, issue.data.endDate)}
      </p>

      {issueDescription && !hasExpandableIssueText && (
        <p class="serif text-lg md:text-xl text-stone-600 leading-relaxed max-w-2xl mx-auto mt-6">
          {issueDescription}
        </p>
      )}

      {hasExpandableIssueText && (
        <details class="issue-intro max-w-2xl mx-auto mt-8 text-left">
          <summary class="cursor-pointer list-none rounded-sm border-y border-stone-200 py-5 text-center">
            {issueDescription && (
              <p class="issue-intro-preview serif text-lg md:text-xl text-stone-600 leading-relaxed">
                {issueDescription}
              </p>
            )}
            <span
              class:list={[
                "inline-block text-[10px] uppercase tracking-[0.3em] font-bold text-stone-500 hover:text-stone-900 transition-colors",
                issueDescription && "mt-4",
              ]}
            >
              <span class="issue-intro-open-label">Leer presentación</span>
              <span class="issue-intro-close-label">Cerrar presentación</span>
            </span>
          </summary>

          <div class="issue-note-content serif text-stone-700 mt-8">
            {issueDescription && (
              <p class="issue-intro-full-description">{issueDescription}</p>
            )}
            {issueBody && <IssueContent />}
          </div>
        </details>
      )}

      <div class="mt-10 text-[10px] uppercase tracking-[0.3em] text-stone-400">
        {issuePostsWithAuthors.length} {issuePostsWithAuthors.length === 1 ? 'texto' : 'textos'}
      </div>
    </header>

    {/* Posts Section */}
    {issuePostsWithAuthors.length > 0 ? (
      <div class="space-y-20 md:space-y-28">
        {categoryGroups.map(({ category, posts }, index) => (
          <section aria-labelledby={`category-${index}`}>
            <header class="flex items-baseline justify-between gap-4 border-b border-stone-200 pb-4 mb-8 md:mb-12">
              <h2 id={`category-${index}`} class="display-serif text-2xl md:text-3xl font-bold">
                {category}
              </h2>
              <span class="text-[10px] uppercase tracking-[0.3em] text-stone-400 shrink-0">
                {posts.length} {posts.length === 1 ? 'texto' : 'textos'}
              </span>
            </header>
            <div class="space-y-14 md:space-y-20">
              {posts.map(({ post, author }) => (
                <PostPreview
                  post={post}
                  authorName={author.data.name}
                  authorSlug={author.slug}
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="max-w-2xl mx-auto text-center py-12">
        <p class="serif text-stone-500 italic text-lg">
          Esta edición aún no tiene textos publicados.
        </p>
      </div>
    )}

    {/* Back to Editions Index */}
    <footer class="mt-24 pt-16 border-t border-stone-100 text-center">
      <a
        href="/numeros"
        class="inline-block px-6 py-3 text-xs uppercase tracking-[0.3em] border border-stone-200 hover:border-stone-400 hover:bg-stone-50 transition rounded-full"
      >
        ← Ver todos los números
      </a>
    </footer>
  </div>
</Shell>
